---
const getList = [
  "Direct mentorship from Senior Architects.",
  "Contribution credit on major client launches.",
  "Competitive monthly stipend.",
  "Official 'Meridian Labs' Internship Certificate.",
];
const expectList = [
  "Proficiency in Figma or VS Code.",
  'A portfolio that shows "serious" intent.',
  "40 hours per week commitment (Remote or On-site).",
  "Zero ego. Just work.",
];
---

<section class="py-section-padding-v px-gutter max-w-container-max mx-auto border-t border-outline-variant grid grid-cols-1 md:grid-cols-12 gap-card-gap md:items-start">
  <div class="md:col-span-5">
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary mb-stack-md">
      Currently Accepting Interns.
    </h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg">
      Our internship program is not about fetching coffee. It's an intensive
      3-month cycle designed to produce portfolio-ready work. You'll be embedded
      in real projects from week two.
    </p>
    <div class="p-8 border border-primary-fixed/20 bg-primary-fixed/5">
      <h4 class="font-label-mono text-label-mono text-primary-fixed mb-4">CURRENT OPENING</h4>
      <p class="font-headline-sm text-headline-sm text-primary">Digital Product Intern (Q3 2024)</p>
    </div>
  </div>

  <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-card-gap gap-y-stack-lg">
    <div class="flex flex-col gap-6">
      <h3 class="font-label-mono text-label-mono text-primary-fixed uppercase tracking-widest border-b border-outline-variant pb-3">
        What you get
      </h3>
      <ul class="flex flex-col gap-4">
        {getList.map((i) => (
          <li class="flex items-start gap-3 font-body-md text-body-md text-on-background">
            <span class="material-symbols-outlined text-primary-fixed text-xl leading-6 shrink-0">check_circle</span>
            <span class="leading-6">{i}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col gap-6">
      <h3 class="font-label-mono text-label-mono text-primary-fixed uppercase tracking-widest border-b border-outline-variant pb-3">
        What we expect
      </h3>
      <ul class="flex flex-col gap-4">
        {expectList.map((i) => (
          <li class="flex items-start gap-3 font-body-md text-body-md text-on-background">
            <span class="material-symbols-outlined text-primary-fixed text-xl leading-6 shrink-0">bolt</span>
            <span class="leading-6">{i}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
